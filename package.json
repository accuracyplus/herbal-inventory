{
  "name": "hifive-inventory",
  "private": true,
  "type": "module",
  "//": "The API Worker. The client is a separate package under client/.",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "wrangler dev",
    "predeploy": "npm test",
    "deploy": "node scripts/deploy.mjs",
    "setup:db": "node scripts/d1-setup.mjs",
    "migrate": "wrangler d1 execute hifive-inventory --remote --yes --file=schema.sql",
    "migrate:local": "wrangler d1 execute hifive-inventory --local --file=schema.sql",
    "seed": "wrangler d1 execute hifive-inventory --remote --yes --file=seed/0001-herbal-park.sql"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
