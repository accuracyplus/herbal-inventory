/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), geolocation=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://hifive-design.pages.dev; style-src 'self' 'unsafe-inline' https://hifive-design.pages.dev https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://hifive-design.pages.dev; connect-src 'self' https://hifive-inventory.sinusuresh.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# camera=(self): the barcode scanner, on this app's own pages only. The ZXing reader used where the
# browser has no BarcodeDetector (every iPhone) is bundled under /assets, so script-src stays self.
#
# img-src blob: — an attached delivery note is fetched with the person's sign-in and opened from
# memory; it has no address of its own to link to.
#
# img-src https://hifive-design.pages.dev — the logo in the tab and on the home screen, in the
# palette being worn (D-042; src/appIcon.js). Images only, from the same site as the theme.
#
# connect-src names the exact Worker origin, not https://*.workers.dev — a wildcard there would
# let any Worker anyone has deployed receive a signed-in member of staff's requests. CSP also
# does not accept a wildcard in the middle of a host (Transport, 5 September 2026).
#
# The theme (boot.js, theme.css) comes from the HiFive design system's own site, as in every
# HiFive app; a copy lives in /theme-fallback/v1 for the day that site is down. Fonts come from
# Google: unlike Transport, this app holds no patient data, so the trade Transport refused is
# acceptable here — the font host sees which fonts load, never what is on the page.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-store

/sw.js
  Cache-Control: no-cache
